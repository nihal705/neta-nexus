# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/neta_nexus

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# API Keys
NEWS_API_KEY=your_news_api_key_here
ECI_API_KEY=your_eci_api_key_here

# Application Settings
APP_NAME=NetaNexus
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# Admin Configuration
ADMIN_EMAIL=admin@netanexus.com
ADMIN_PASSWORD_HASH=change_this

# CORS Settings (for production, specify actual domains)
CORS_ORIGINS=["http://localhost:3000", "https://netanexus.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cloud Storage (optional - for candidate photos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=neta-nexus-photos
AWS_REGION=ap-south-1

# Sentry for error tracking (optional)
SENTRY_DSN=